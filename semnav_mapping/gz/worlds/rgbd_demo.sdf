<?xml version="1.6" ?>
<sdf version="1.7">
  <world name="rgbd_demo_world">
    <gravity>0 0 -9.81</gravity>

    <!-- Simple ground plane -->
    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- A box to look at -->
    <model name="box">
      <pose>1 0 0.5 0 0 0</pose>
      <link name="link">
        <inertial><mass>1</mass></inertial>
        <collision name="collision">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material><ambient>0.6 0.2 0.2 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- RGB-D camera looking at the box -->
    <model name="rgbd_cam">
      <pose>0 0 1.0 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <sensor name="camera" type="rgbd_camera">
          <always_on>true</always_on>
          <update_rate>30</update_rate>
          <topic>/camera</topic>
          <pose>0 0 0 0 0 0</pose>
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image><width>640</width><height>480</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>8.0</far></clip>
          </camera>
          <depth_camera>
            <clip><near>0.1</near><far>8.0</far></clip>
          </depth_camera>
        </sensor>
      </link>
    </model>

  </world>
</sdf>
